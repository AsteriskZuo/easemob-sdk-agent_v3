{
  "name": "easemob-skill-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">= 24"
  },
  "workspaces": [
    "packages/*",
    "app/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Apt run build",
    "test": "yarn build && yarn workspaces foreach -Apt run test",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "lint": "eslint packages app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "circular": "dpdm --circular --transform \"packages/*/src/**/*.ts\" \"app/*/src/**/*.ts\" \"app/*/src/**/*.tsx\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "dpdm": "^4.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.63.0"
  }
}
