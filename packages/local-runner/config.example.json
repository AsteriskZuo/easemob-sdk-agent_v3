{
  "business_id": "<平台分配的业务 id，如 b01M4QSEAC5MZA2N2RTNMEDDCX1>",
  "channel_id": "webhook__<工单号>__<平台业务 id>",
  "prompt": "<与平台业务资料一致，建议从平台快照 JSON 复制>",
  "entry_program": "main",
  "model": "qwen/qwen3.8-max",

  "assets": {
    "package": { "path": "../../business/jira-ticket-review/package" },
    "tools": [
      { "name": "jira-fetch", "path": "../../business/jira-ticket-review/tools/jira-fetch" }
    ],
    "skills": [
      { "name": "jira-ticket-review", "path": "../../business/jira-ticket-review/skills" }
    ]
  },

  "vars": { "jira_url": "https://jira.example.com" },
  "secrets": {
    "jira_username": "<platform.db env_entries 真值，严禁提交 git>",
    "jira_password": "<真值>",
    "jira_redirect_username": "<真值>",
    "jira_redirect_password": "<真值>",
    "wecom_key": "<真值>"
  },

  "pi_agent_dir": "../../.easemob-agent-workspace/businesses/<平台业务 id>/cache/pi/agent",
  "pi_cli_path": null,
  "pi_env": {},

  "quota": { "timeout_minutes": 60, "max_agent_calls": 20 },

  "workspace_root": "./workspace",

  "stub_tools": [],
  "stub_outputs": {}
}
