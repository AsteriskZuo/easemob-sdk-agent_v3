# syntax=docker/dockerfile:1

# 调研推荐：
# - 第一版稳定保守可用 node:22-bookworm-slim。
# - 长期推荐迁移到 node:24-bookworm-slim，因为 Node 24 当前是 Active LTS。
ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS deps
WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
RUN corepack enable && yarn install --immutable

FROM deps AS build
COPY tsconfig.json ./
COPY src ./src
RUN yarn build

FROM ${NODE_IMAGE} AS runtime

ENV NODE_ENV=production
ENV APP_CONFIG_FILE=/etc/easemob-sdk-agent/config.json
ENV APP_DATA_DIR=/var/lib/easemob-sdk-agent
ENV CODEX_HOME=/home/node/.codex

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openssh-client \
    tini \
  && rm -rf /var/lib/apt/lists/*

# Codex CLI 安装方式需要在正式实现时锁定版本或安装包来源。
# 官方 manual 记录了 standalone installer：
# curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
# 为避免调研样例在构建时隐式联网，本文件不直接执行安装。

WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
RUN corepack enable && yarn workspaces focus --all --production

COPY --from=build /app/dist ./dist

RUN mkdir -p \
    /etc/easemob-sdk-agent \
    /var/lib/easemob-sdk-agent \
    /home/node/.codex \
    /workspaces \
  && chown -R node:node \
    /app \
    /var/lib/easemob-sdk-agent \
    /home/node/.codex \
    /workspaces

VOLUME ["/var/lib/easemob-sdk-agent", "/home/node/.codex", "/workspaces"]

USER node
ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/bin/cli.js"]
