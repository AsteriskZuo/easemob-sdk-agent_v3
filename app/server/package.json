{
  "name": "@asterisk/agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@asterisk/agent-asset-registry": "0.1.0",
    "@asterisk/agent-channel": "0.1.0",
    "@asterisk/agent-console-api": "0.1.0",
    "@asterisk/agent-contracts": "0.1.0",
    "@asterisk/agent-database": "0.1.0",
    "@asterisk/agent-entry-adapters": "0.1.0",
    "@asterisk/agent-env": "0.1.0",
    "@asterisk/agent-exit-tools": "0.1.0",
    "@asterisk/agent-logger": "0.1.0",
    "@asterisk/agent-queue": "0.1.0",
    "@asterisk/agent-registry": "0.1.0",
    "@asterisk/agent-runtime": "0.1.0",
    "@asterisk/agent-scheduler": "0.1.0",
    "@asterisk/agent-service": "0.1.0",
    "@asterisk/agent-workflow-runner": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "yarn workspaces foreach -Apt run build && rm -rf dist-test && esbuild $(find src -name '*.ts') --outdir=dist-test/src --outbase=src --format=esm --platform=node --target=node24 --sourcemap --log-level=error && esbuild $(find tests -name '*.ts') --outdir=dist-test/tests --outbase=tests --format=esm --platform=node --target=node24 --sourcemap --log-level=error && NODE_OPTIONS='--experimental-vm-modules' jest --config ../../jest.compiled.config.mjs --rootDir .",
    "typecheck": "tsc --noEmit"
  }
}
